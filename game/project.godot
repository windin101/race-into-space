; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Race Into Space"
config/description="Hobby reimplementation of the 1993 space-race strategy game, GPL-2.0-or-later."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/data/game_data.gd"
Settings="*res://scripts/ui/settings.gd"
Session="*res://scripts/ui/session.gd"
Screens="*res://scripts/ui/screen_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[gui]

theme/default_theme_scale=1.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
